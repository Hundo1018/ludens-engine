ludens-schema 1
# Particle emitters (game/particles.mojo, docs/particles.md). One entry is one emitter asset; the scene component
# `particles` (docs/scene-format.md 8a) names an entry and sets where it is and its seed.
particles.schema.version = 1
particles.schema.rate.kind = real
particles.schema.rate.default = 0
particles.schema.rate.min = 0
particles.schema.rate.max = 1000000
particles.schema.rate.doc = "particles per second while playing"
particles.schema.burst_count.kind = integer
particles.schema.burst_count.default = 0
particles.schema.burst_count.min = 0
particles.schema.burst_count.max = 1000000
particles.schema.burst_count.doc = "particles in each burst; the first burst is at time 0"
particles.schema.burst_every.kind = real
particles.schema.burst_every.default = 0
particles.schema.burst_every.min = 0
particles.schema.burst_every.max = 3600
particles.schema.burst_every.doc = "seconds between bursts; 0 = one burst"
particles.schema.lifetime_min.kind = real
particles.schema.lifetime_min.default = 1
particles.schema.lifetime_min.min = 0.01
particles.schema.lifetime_min.max = 600
particles.schema.lifetime_max.kind = real
particles.schema.lifetime_max.default = 1
particles.schema.lifetime_max.min = 0.01
particles.schema.lifetime_max.max = 600
particles.schema.speed_min.kind = real
particles.schema.speed_min.default = 1
particles.schema.speed_min.min = 0
particles.schema.speed_min.max = 1000
particles.schema.speed_max.kind = real
particles.schema.speed_max.default = 1
particles.schema.speed_max.min = 0
particles.schema.speed_max.max = 1000
particles.schema.direction.kind = vector
particles.schema.direction.size = 3
particles.schema.direction.default = 0 1 0
particles.schema.direction.doc = "axis of the velocity cone, in the emitter's frame; normalised on load"
particles.schema.cone_deg.kind = real
particles.schema.cone_deg.default = 0
particles.schema.cone_deg.min = 0
particles.schema.cone_deg.max = 180
particles.schema.cone_deg.doc = "half angle of the velocity cone, degrees"
particles.schema.gravity.kind = vector
particles.schema.gravity.size = 3
particles.schema.gravity.default = 0 -9.81 0
particles.schema.drag.kind = real
particles.schema.drag.default = 0
particles.schema.drag.min = 0
particles.schema.drag.max = 100
particles.schema.drag.doc = "velocity is divided by 1 + drag * dt each step"
particles.schema.size_curve.kind = list
particles.schema.size_curve.of = real
particles.schema.size_curve.min = 0
particles.schema.size_curve.max = 1000
particles.schema.size_curve.min_count = 1
particles.schema.size_curve.max_count = 16
particles.schema.size_curve.required = true
particles.schema.size_curve.doc = "size in metres at equal steps of life, linear between"
particles.schema.size_jitter.kind = real
particles.schema.size_jitter.default = 0
particles.schema.size_jitter.min = 0
particles.schema.size_jitter.max = 1
particles.schema.size_jitter.doc = "each particle's size is scaled by a random factor in 1 - jitter .. 1"
particles.schema.color_start.kind = vector
particles.schema.color_start.size = 4
particles.schema.color_start.default = 1 1 1 1
particles.schema.color_start.min = 0
particles.schema.color_start.doc = "r g b a at the start of life"
particles.schema.color_mid.kind = vector
particles.schema.color_mid.size = 4
particles.schema.color_mid.default = 1 1 1 1
particles.schema.color_mid.min = 0
particles.schema.color_end.kind = vector
particles.schema.color_end.size = 4
particles.schema.color_end.default = 1 1 1 0
particles.schema.color_end.min = 0
particles.schema.blend.kind = enumeration
particles.schema.blend.values = alpha add
particles.schema.blend.default = alpha
particles.schema.layer.kind = integer
particles.schema.layer.default = 0
particles.schema.layer.min = 0
particles.schema.layer.max = 255
particles.schema.layer.doc = "texture array layer; 0 is the engine's white layer and draws a soft disc"
particles.schema.flipbook_cols.kind = integer
particles.schema.flipbook_cols.default = 1
particles.schema.flipbook_cols.min = 1
particles.schema.flipbook_cols.max = 16
particles.schema.flipbook_rows.kind = integer
particles.schema.flipbook_rows.default = 1
particles.schema.flipbook_rows.min = 1
particles.schema.flipbook_rows.max = 16
particles.schema.max_particles.kind = integer
particles.schema.max_particles.default = 1000
particles.schema.max_particles.min = 1
particles.schema.max_particles.max = 1000000
particles.schema.max_particles.doc = "budget of this emitter; a spawn past it is dropped and counted"
particles.schema.lod_near.kind = real
particles.schema.lod_near.default = 0
particles.schema.lod_near.min = 0
particles.schema.lod_near.max = 100000
particles.schema.lod_near.doc = "metres: the emission rate is full up to this camera distance"
particles.schema.lod_far.kind = real
particles.schema.lod_far.default = 0
particles.schema.lod_far.min = 0
particles.schema.lod_far.max = 100000
particles.schema.lod_far.doc = "metres: at and past this distance the rate is lod_min of full; 0 = no LOD"
particles.schema.lod_min.kind = real
particles.schema.lod_min.default = 0
particles.schema.lod_min.min = 0
particles.schema.lod_min.max = 1
