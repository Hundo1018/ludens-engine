"""The demo game's default action map as text, so a wasm64 module needs no file. Generated by scripts/gen_actions.py from
game/data/demo.actions; do not edit by hand (`pixi run -e wasm lint` fails when this file is not what the generator writes)."""

comptime DEMO_ACTIONS_TEXT = """ludens-actions 1
# The demo game's input, by intent. A game reads these names, never a key. Format: docs/input.md
action move stick deadzone=0.2 curve=1.0
action look look
action jump button buffer_ms=100
action pause button
action restart button

bind move.up key:KeyW
bind move.up key:ArrowUp
bind move.up pad:b12
bind move.down key:KeyS
bind move.down key:ArrowDown
bind move.down pad:b13
bind move.left key:KeyA
bind move.left key:ArrowLeft
bind move.left pad:b14
bind move.right key:KeyD
bind move.right key:ArrowRight
bind move.right pad:b15
bind move.x pad:a0
bind move.x vpad:a0
bind move.y -pad:a1
bind move.y -vpad:a1

bind look mouse:drag0

bind jump key:Space
bind jump pad:b0
bind jump vpad:b0
bind pause key:KeyP
bind pause key:Escape
bind pause pad:b9
bind pause vpad:b9
bind restart key:KeyR
bind restart pad:b3
bind restart vpad:b3
"""
