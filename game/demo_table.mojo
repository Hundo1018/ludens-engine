"""Typed accessors of the `demo` data table. Generated by scripts/gen_table.py from game/data/demo.schema; do not edit
by hand (`pixi run -e wasm lint` fails when this file is not what the generator writes)."""
from game.table import Table, table_load

comptime DEMO_SIGNATURE = "speed:real jump_speed:real jump_enabled:boolean gravity_y:real look_sensitivity:real"
comptime DEMO_SCHEMA_TEXT = "ludens-schema 1\n# The demo game's tuning values (game/demo_mode.mojo). Every field is read once per tick, so a live edit applies at a tick boundary.\ndemo.schema.version = 1\ndemo.schema.speed.kind = real\ndemo.schema.speed.default = 5\ndemo.schema.speed.min = 0.5\ndemo.schema.speed.max = 20\ndemo.schema.speed.doc = \"ball speed, m/s\"\ndemo.schema.jump_speed.kind = real\ndemo.schema.jump_speed.default = 5\ndemo.schema.jump_speed.min = 0\ndemo.schema.jump_speed.max = 20\ndemo.schema.jump_speed.doc = \"vertical speed of a jump, m/s\"\ndemo.schema.jump_enabled.kind = boolean\ndemo.schema.jump_enabled.default = true\ndemo.schema.gravity_y.kind = real\ndemo.schema.gravity_y.default = -9.81\ndemo.schema.gravity_y.min = -50\ndemo.schema.gravity_y.max = 0\ndemo.schema.gravity_y.doc = \"m/s^2, negative is down\"\ndemo.schema.look_sensitivity.kind = real\ndemo.schema.look_sensitivity.default = 0.006\ndemo.schema.look_sensitivity.min = 0.0005\ndemo.schema.look_sensitivity.max = 0.05\ndemo.schema.look_sensitivity.doc = \"radians of yaw per pixel of mouse movement\"\n"
comptime DEMO_TABLE_TEXT = "ludens-table 1 schema 1\n# One entry, every value at its schema default: the game plays as it did before the table existed.\ndemo.main = +\n"



struct DemoRow(Copyable, Movable):
    var id: String
    var speed: Float64
    var jump_speed: Float64
    var jump_enabled: Bool
    var gravity_y: Float64
    var look_sensitivity: Float64

    def __init__(out self, id: String):
        self.id = id
        self.speed = 0.0
        self.jump_speed = 0.0
        self.jump_enabled = False
        self.gravity_y = 0.0
        self.look_sensitivity = 0.0


def demo_rows(t: Table) raises -> List[DemoRow]:
    """Every entry of `t`, in file order. Raises when `t` was not read under the schema this file was generated from."""
    if t.schema.signature() != DEMO_SIGNATURE:
        raise Error(t.file + ": the schema is `" + t.schema.signature() + "`, the accessors were generated for `" + DEMO_SIGNATURE + "`")
    var out = List[DemoRow]()
    for e in range(len(t.entries)):
        var r = DemoRow(t.entries[e].id)
        r.speed = t.entries[e].values[0].nums[0]
        r.jump_speed = t.entries[e].values[1].nums[0]
        r.jump_enabled = t.entries[e].values[2].nums[0] != 0.0
        r.gravity_y = t.entries[e].values[3].nums[0]
        r.look_sensitivity = t.entries[e].values[4].nums[0]
        out.append(r^)
    return out^


def demo_row(t: Table, id: String) raises -> DemoRow:
    var rows = demo_rows(t)
    for r in rows:
        if r.id == id:
            return r.copy()
    raise Error(t.file + ": table `demo` has no entry `" + id + "`")


def demo_default_table() raises -> Table:
    """The table text this file was generated with, read under the schema it was generated with."""
    return table_load(DEMO_SCHEMA_TEXT, "game/data/demo.schema", DEMO_TABLE_TEXT, "game/data/demo.table")

