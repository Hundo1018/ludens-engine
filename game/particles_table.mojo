struct ParticlesRow(Copyable, Movable):
    var id: String
    var rate: Float64
    var burst_count: Int
    var burst_every: Float64
    var lifetime_min: Float64
    var lifetime_max: Float64
    var speed_min: Float64
    var speed_max: Float64
    var direction: List[Float64]
    var cone_deg: Float64
    var gravity: List[Float64]
    var drag: Float64
    var size_curve: List[Float64]
    var size_jitter: Float64
    var color_start: List[Float64]
    var color_mid: List[Float64]
    var color_end: List[Float64]
    var blend: Int
    var layer: Int
    var flipbook_cols: Int
    var flipbook_rows: Int
    var max_particles: Int
    var lod_near: Float64
    var lod_far: Float64
    var lod_min: Float64

    def __init__(out self, id: String):
        self.id = id
        self.rate = 0.0
        self.burst_count = 0
        self.burst_every = 0.0
        self.lifetime_min = 0.0
        self.lifetime_max = 0.0
        self.speed_min = 0.0
        self.speed_max = 0.0
        self.direction = List[Float64]()
        self.cone_deg = 0.0
        self.gravity = List[Float64]()
        self.drag = 0.0
        self.size_curve = List[Float64]()
        self.size_jitter = 0.0
        self.color_start = List[Float64]()
        self.color_mid = List[Float64]()
        self.color_end = List[Float64]()
        self.blend = 0
        self.layer = 0
        self.flipbook_cols = 0
        self.flipbook_rows = 0
        self.max_particles = 0
        self.lod_near = 0.0
        self.lod_far = 0.0
        self.lod_min = 0.0


def _word_index(t: Table, field: String, word: String) raises -> Int:
    var f = t.schema.find(field.lower())
    for i in range(len(t.schema.fields[f].values)):
        if t.schema.fields[f].values[i] == word:
            return i
    raise Error(t.file + ": `" + word + "` is not a word of " + field.lower())


def particles_rows(t: Table) raises -> List[ParticlesRow]:
    """Every entry of `t`, in file order. Raises when `t` was not read under the schema this file was generated from."""
    if t.schema.signature() != PARTICLES_SIGNATURE:
        raise Error(t.file + ": the schema is `" + t.schema.signature() + "`, the accessors were generated for `" + PARTICLES_SIGNATURE + "`")
    var out = List[ParticlesRow]()
    for e in range(len(t.entries)):
        var r = ParticlesRow(t.entries[e].id)
        r.rate = t.entries[e].values[0].nums[0]
        r.burst_count = Int(t.entries[e].values[1].nums[0])
        r.burst_every = t.entries[e].values[2].nums[0]
        r.lifetime_min = t.entries[e].values[3].nums[0]
        r.lifetime_max = t.entries[e].values[4].nums[0]
        r.speed_min = t.entries[e].values[5].nums[0]
        r.speed_max = t.entries[e].values[6].nums[0]
        r.direction = t.entries[e].values[7].nums.copy()
        r.cone_deg = t.entries[e].values[8].nums[0]
        r.gravity = t.entries[e].values[9].nums.copy()
        r.drag = t.entries[e].values[10].nums[0]
        r.size_curve = t.entries[e].values[11].nums.copy()
        r.size_jitter = t.entries[e].values[12].nums[0]
        r.color_start = t.entries[e].values[13].nums.copy()
        r.color_mid = t.entries[e].values[14].nums.copy()
        r.color_end = t.entries[e].values[15].nums.copy()
        r.blend = _word_index(t, "BLEND", t.entries[e].values[16].strs[0])
        r.layer = Int(t.entries[e].values[17].nums[0])
        r.flipbook_cols = Int(t.entries[e].values[18].nums[0])
        r.flipbook_rows = Int(t.entries[e].values[19].nums[0])
        r.max_particles = Int(t.entries[e].values[20].nums[0])
        r.lod_near = t.entries[e].values[21].nums[0]
        r.lod_far = t.entries[e].values[22].nums[0]
        r.lod_min = t.entries[e].values[23].nums[0]
        out.append(r^)
    return out^


def particles_row(t: Table, id: String) raises -> ParticlesRow:
    var rows = particles_rows(t)
    for r in rows:
        if r.id == id:
            return r.copy()
    raise Error(t.file + ": table `particles` has no entry `" + id + "`")


def particles_default_table() raises -> Table:
    """The table text this file was generated with, read under the schema it was generated with."""
    return table_load(PARTICLES_SCHEMA_TEXT, "game/data/particles.schema", PARTICLES_TABLE_TEXT, "game/data/particles.table")

