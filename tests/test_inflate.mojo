# tier: unit
"""DEFLATE and zlib decoding (ROADMAP 17.63, `geometry.inflate`).

GENERATED by scripts/zlib_vectors.py from Python's zlib 1.3.2. Do not edit by
hand; rerun the script. Every compressed input below was accepted by zlib with
the output this file expects, and every rejected input was rejected by zlib.

Vectors: a stored block (level 0), a fixed-Huffman block (Z_FIXED), a
dynamic-Huffman block (BTYPE 2 found by search), the raw DEFLATE form of the
dynamic vector, the max_out limit, and error cases: Adler-32 mismatch, bad
header check, truncated stream, a distance before the output start, a reserved
block type, a stored length mismatch.
"""

from harness.runner import Suite
from geometry.inflate import inflate, zlib_inflate


def unhex(h: String) -> List[UInt8]:
    var b = h.as_bytes()
    var out = List[UInt8]()
    var i = 0
    while i + 1 < len(b):
        out.append(UInt8(_nib(b[i]) * 16 + _nib(b[i + 1])))
        i += 2
    return out^


def _nib(c: UInt8) -> Int:
    if c >= 97:
        return Int(c) - 87
    return Int(c) - 48


def ramp(n: Int) -> List[UInt8]:
    var out = List[UInt8]()
    for i in range(n):
        out.append(UInt8((i * 37) % 251))
    return out^


def fox(n: Int) -> List[UInt8]:
    var pat = String("the quick brown fox ")
    var b = pat.as_bytes()
    var out = List[UInt8]()
    for i in range(n):
        out.append(b[i % len(b)])
    return out^


def same(a: List[UInt8], b: List[UInt8]) -> Bool:
    if len(a) != len(b):
        return False
    for i in range(len(a)):
        if a[i] != b[i]:
            return False
    return True


def zlib_fails(d: List[UInt8]) -> Bool:
    try:
        _ = zlib_inflate(d)
    except:
        return True
    return False


def raw_fails(d: List[UInt8]) -> Bool:
    try:
        _ = inflate(d)
    except:
        return True
    return False


def main() raises:
    var s = Suite("inflate")

    var stored = unhex("")
    s.check(same(zlib_inflate(stored), ramp(300)), "zlib stored block (level 0) decodes to the input")

    var fixed = unhex("78012bc94855282ccd4cce56482aca2fcf5348cbaf502819826200d644493f")
    s.check(same(zlib_inflate(fixed), fox(200)), "zlib fixed-Huffman block (Z_FIXED) decodes to the input")

    var dynamic = unhex("789cedc8510a00101045d1adbcb511d19489462cdf3ad43d9f275ad1dc3d9bd2f23354fd2a388ee3388ee3388efbfc1e8cc25d23")
    s.check(same(zlib_inflate(dynamic), fox(3050)), "zlib dynamic-Huffman block decodes to the input")

    var raw = List[UInt8]()
    for i in range(2, len(dynamic) - 4):
        raw.append(dynamic[i])
    s.check(same(inflate(raw), fox(3050)), "raw DEFLATE of the dynamic vector decodes to the same input")

    s.check(same(inflate(unhex("010000ffff")), List[UInt8]()), "raw empty stored final block decodes to nothing")

    var lim_ok = True
    try:
        _ = zlib_inflate(dynamic, 3050 - 1)
        lim_ok = False
    except:
        pass
    s.check(lim_ok, "max_out below the output size raises")
    s.check(same(zlib_inflate(dynamic, 3050), fox(3050)), "max_out equal to the output size passes")

    s.check(zlib_fails(unhex("789cedc8510a00101045d1adbcb511d19489462cdf3ad43d9f275ad1dc3d9bd2f23354fd2a388ee3388ee3388efbfc1e8cc25d22")), "a corrupted Adler-32 trailer raises")
    s.check(zlib_fails(unhex("789dedc8510a00101045d1adbcb511d19489462cdf3ad43d9f275ad1dc3d9bd2f23354fd2a388ee3388ee3388efbfc1e8cc25d23")), "a bad zlib header check raises")
    s.check(zlib_fails(unhex("789cedc8510a00101045d1adbcb511d19489462cdf3ad43d9f275ad1dc3d9bd2f23354fd2a388ee3388ee3388efbfc1e8c")), "a truncated zlib stream raises")
    s.check(raw_fails(unhex("0302")), "a distance before the output start raises")
    s.check(raw_fails(unhex("07")), "a reserved block type (3) raises")
    s.check(raw_fails(unhex("0105000000")), "a stored length that fails its one's complement check raises")
    s.check(zlib_fails(List[UInt8]()), "an empty zlib stream raises")
    s.finish()
