#!/usr/bin/env bash
# ROADMAP 17.87: Conventional Commits subject; rules in scripts/hooks.py.
# Install: pixi run install-hooks. Skip once: git commit --no-verify.
cd "$(git rev-parse --show-toplevel)" || exit 1
command -v pixi >/dev/null || { echo "[hooks] pixi not found: commit-msg checks skipped" >&2; exit 0; }
exec pixi run python3 scripts/hooks.py commit-msg "$@"
